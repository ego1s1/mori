<?xml version="1.0" encoding="utf-8"?>
<!--
  Least-privilege backup: only the library index (Room) and reading progress
  (DataStore) survive reinstalls — enumerated by exact file, never whole
  directories. Regenerable covers and transient caches do not back up.
  SAF folder grants never survive a restore — rows pointing at dead URIs
  degrade to error states with a relink path, never a crash.
-->
<full-backup-content>
    <include domain="database" path="mori.db" />
    <include domain="file" path="datastore/mori_preferences.preferences_pb" />
</full-backup-content>
