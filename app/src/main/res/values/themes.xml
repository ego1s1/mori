<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mori.Base" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <!-- Splash host: black bed (no wrong-scheme flash), then the base theme. -->
    <style name="Theme.Mori" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="postSplashScreenTheme">@style/Theme.Mori.Base</item>
    </style>
</resources>
